<Window x:Class="DesktopDock.ApplicationRuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用避让规则" Width="540" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources><ResourceDictionary Source="SettingsStyles.xaml" /></Window.Resources>
    <Border Background="{StaticResource Canvas}" Padding="22">
        <StackPanel>
            <TextBlock Text="应用程序路径" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="浏览" Click="Browse" Margin="8,0,0,0" />
                <TextBox x:Name="ApplicationPathInput" AutomationProperties.Name="应用程序路径" />
            </DockPanel>
            <TextBlock Text="应用位于前台时" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" />
            <ComboBox x:Name="ActionInput" AutomationProperties.Name="应用避让动作" Height="34" VerticalContentAlignment="Center">
                <ComboBoxItem Content="允许热区自动呼出" />
                <ComboBoxItem Content="禁止热区自动呼出" />
            </ComboBox>
            <TextBlock x:Name="ValidationMessage" Visibility="Collapsed" Foreground="#FF9A3025" TextWrapping="Wrap" Margin="0,11,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="应用" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Apply" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
