<UserControl x:Class="DesktopDock.BehaviorSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,4">
            <TextBlock Style="{DynamicResource FieldLabel}" Text="工作模式" />
            <ComboBox x:Name="ModeInput" AutomationProperties.Name="工作模式" Width="178" Height="34"
                      HorizontalAlignment="Left" VerticalContentAlignment="Center" SelectionChanged="ModeChanged">
                <ComboBoxItem Content="常驻" />
                <ComboBoxItem Content="自动隐藏" />
            </ComboBox>
            <Separator Margin="0,17,0,13" Background="{DynamicResource Rule}" />

            <TextBlock Style="{DynamicResource FieldLabel}" Text="显示器与热区" />
            <ComboBox x:Name="MonitorInput" AutomationProperties.Name="热区显示器" Height="34" DisplayMemberPath="Label"
                      VerticalContentAlignment="Center" SelectionChanged="MonitorChanged" />
            <Grid Margin="0,9,0,6" MinHeight="112">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="ZoneList" AutomationProperties.Name="热区顺序" MaxHeight="152" MinHeight="112" Padding="5"
                         BorderBrush="{DynamicResource Rule}" Background="White" SelectionChanged="ZoneChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{DynamicResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" /></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="2" Padding="7" BorderThickness="1" BorderBrush="{DynamicResource Rule}" Background="White" CornerRadius="5">
                    <Canvas x:Name="ZonePreview" MinHeight="96" SizeChanged="PreviewSizeChanged"
                            AutomationProperties.Name="所选显示器的热区预览" ClipToBounds="True" />
                </Border>
            </Grid>
            <TextBlock x:Name="ZoneStatus" Style="{DynamicResource FieldHint}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,5" />
            <WrapPanel>
                <Button x:Name="AddZoneButton" Content="添加热区" Click="AddZone" Margin="0,0,6,5" />
                <Button x:Name="EditZoneButton" Content="编辑" Click="EditZone" Margin="0,0,6,5" />
                <Button x:Name="RemoveZoneButton" Content="移除" Click="RemoveZone" Margin="0,0,6,5" />
                <Button x:Name="RaiseZoneButton" Content="上移" Click="RaiseZone" Margin="0,0,6,5" />
                <Button x:Name="LowerZoneButton" Content="下移" Click="LowerZone" Margin="0,0,6,5" />
                <Button x:Name="ResetZonesButton" Content="恢复默认" Click="ResetZones" Margin="0,0,0,5" />
            </WrapPanel>
            <Separator Margin="0,13,0,12" Background="{DynamicResource Rule}" />

            <TextBlock Style="{DynamicResource FieldLabel}" Text="应用避让规则" />
            <ListBox x:Name="RulesList" AutomationProperties.Name="应用避让规则" MinHeight="46" MaxHeight="140" Padding="5"
                     BorderBrush="{DynamicResource Rule}" Background="White" SelectionChanged="RuleChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{DynamicResource NavItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Rule.ExecutablePath}" /></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="添加应用规则" Click="AddRule" Margin="0,0,6,5" />
                <Button x:Name="EditRuleButton" Content="编辑规则" Click="EditRule" Margin="0,0,6,5" />
                <Button x:Name="RemoveRuleButton" Content="移除规则" Click="RemoveRule" Margin="0,0,6,5" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
