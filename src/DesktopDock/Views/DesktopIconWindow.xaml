<Window x:Class="DesktopDock.DesktopIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面图标" Width="520" MinWidth="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="/DesktopDock;component/Views/SettingsStyles.xaml" />
    </Window.Resources>
    <StackPanel Background="{StaticResource Canvas}" TextElement.Foreground="{StaticResource Ink}">
        <StackPanel Margin="26,22,26,20">
            <TextBlock Text="桌面图标" FontSize="25" FontWeight="SemiBold" />
            <TextBlock x:Name="StateText" Margin="0,10,0,12" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Margin="0,0,0,14" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                       Text="临时隐藏会影响当前显示的普通和系统图标。桌面文件仍可通过文件资源管理器访问。" />
            <WrapPanel Margin="0,0,0,14">
                <Button x:Name="HideButton" Content="隐藏桌面图标…" Click="HideIcons" Margin="0,0,8,5" />
                <Button x:Name="RestoreButton" Content="恢复桌面图标" Click="RestoreIcons"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,5" />
            </WrapPanel>
            <TextBlock x:Name="ShortcutText" Style="{StaticResource FieldHint}" Margin="0,0,0,18" TextWrapping="Wrap" />
            <Border Height="1" Background="{StaticResource Rule}" Margin="0,0,0,15" />
            <TextBlock Text="Windows 手动恢复" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock x:Name="ManualText" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="如需单独管理「此电脑」和「回收站」等系统图标，打开 Windows 主题设置，再选择「桌面图标设置」。" />
            <DockPanel Margin="0,17,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="打开 Windows 主题设置" Click="OpenWindowsThemes" />
                <Button DockPanel.Dock="Right" Content="关闭" Click="CloseWindow" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</Window>
