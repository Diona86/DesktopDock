<Window x:Class="DesktopDock.DockGroupDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除分组" Width="510" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources><ResourceDictionary Source="SettingsStyles.xaml" /></Window.Resources>
    <Border Background="{StaticResource Canvas}" Padding="22">
        <StackPanel>
            <TextBlock x:Name="GroupTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Summary" Style="{StaticResource FieldHint}" Margin="0,6,0,14" />
            <RadioButton x:Name="MoveOption" Content="将内容移到上一级" GroupName="DeletionChoice"
                         Checked="SelectChoice" Padding="4,2,0,2" />
            <TextBlock x:Name="DestinationHint" Style="{StaticResource FieldHint}" Margin="20,3,0,12" />
            <RadioButton x:Name="RemoveOption" Content="移除内部项目引用" GroupName="DeletionChoice"
                         Checked="SelectChoice" Padding="4,2,0,2" />
            <TextBlock Style="{StaticResource FieldHint}" Margin="20,3,0,0" Text="移除本分组、子分组及其内部项目的 Dock 引用。原始项目文件保留。" />
            <TextBlock x:Name="ErrorMessage" Visibility="Collapsed" Foreground="#FF9A3025" TextWrapping="Wrap"
                       Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="取消" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Content="删除分组" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="Confirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
