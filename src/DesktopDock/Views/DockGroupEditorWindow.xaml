<Window x:Class="DesktopDock.DockGroupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑分组" Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources><ResourceDictionary Source="SettingsStyles.xaml" /></Window.Resources>
    <Border Background="{StaticResource Canvas}" Padding="22">
        <StackPanel>
            <TextBlock x:Name="PlacementHint" Style="{StaticResource FieldHint}" Margin="0,0,0,10" Visibility="Collapsed" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="分组名称" />
            <TextBox x:Name="NameInput" AutomationProperties.Name="分组名称" />

            <StackPanel x:Name="EditFields" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="展开方式" />
                        <ComboBox x:Name="ExpandModeInput" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="分组展开方式">
                            <ComboBoxItem Content="网格" />
                            <ComboBoxItem Content="扇形" />
                            <ComboBoxItem Content="横向" />
                            <ComboBoxItem Content="纵向" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="展开方向" />
                        <ComboBox x:Name="DirectionInput" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="分组展开方向">
                            <ComboBoxItem Content="沿用布局设置" />
                            <ComboBoxItem Content="向上" />
                            <ComboBoxItem Content="向下" />
                            <ComboBoxItem Content="向左" />
                            <ComboBoxItem Content="向右" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource FieldLabel}" Text="分组图标" Margin="0,16,0,6" />
                <TextBlock x:Name="IconLabel" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="选择图标" Click="ChooseIcon" Margin="0,0,8,0" />
                    <Button x:Name="ResetIconButton" Content="恢复默认" Click="ResetIcon" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="ErrorMessage" Visibility="Collapsed" Foreground="#FF9A3025" TextWrapping="Wrap"
                       Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
