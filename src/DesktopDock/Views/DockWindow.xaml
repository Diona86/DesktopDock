<Window x:Class="DesktopDock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopDock"
        Title="Desktop Dock" AutomationProperties.AutomationId="DesktopDockWindow"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="0" Top="0" SizeToContent="WidthAndHeight"
        AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="DockForeground" Color="#FFF3F3ED"/>
        <SolidColorBrush x:Key="DockAccent" Color="#FFB6CDBD"/>
        <Style x:Key="ResizeZone" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DockForeground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Thumb x:Name="TileResize" Width="19" Height="16" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" Visibility="Collapsed" Focusable="False" Cursor="SizeNWSE"
                                       AutomationProperties.AutomationId="DockTileResize"
                                       AutomationProperties.Name="调整图标占格"
                                       ToolTip="拖动调整图标占格，靠近屏幕边缘时向屏幕内拖动">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#F0202422" CornerRadius="3">
                                                <Path Data="M 0,5 L 5,0 M 4,5 L 7,2"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stroke="{StaticResource DockAccent}" StrokeThickness="1"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="local:DockWindow.IsResizableTile" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TileResize" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger SourceName="TileResize" Property="IsMouseCaptured" Value="True">
                                <Setter TargetName="TileResize" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="local:DockWindow.IsExpandedTile" Value="True">
                    <Setter Property="Background" Value="#253E5146"/>
                    <Setter Property="BorderBrush" Value="#3B91A797"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#253E5146"/>
                    <Setter Property="BorderBrush" Value="#4B91A797"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#66465A4C"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource DockAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
    <Border x:Name="Surface" Background="#F0202422" BorderBrush="#C9525B54"
            BorderThickness="1" Padding="5" CornerRadius="13">
        <DockPanel>
            <Border x:Name="GripZone" DockPanel.Dock="Left" Background="Transparent">
                <Button x:Name="MoveHandle" Style="{StaticResource DockButton}" Width="20" Height="24"
                        Visibility="Hidden" Focusable="False" Cursor="SizeAll" ToolTip="移动 Dock"
                        AutomationProperties.AutomationId="DockMoveHandle" AutomationProperties.Name="移动 Dock">
                    <StackPanel x:Name="GripDots">
                        <Ellipse Width="3" Height="3" Fill="{StaticResource DockAccent}" Margin="1.5"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource DockAccent}" Margin="1.5"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource DockAccent}" Margin="1.5"/>
                    </StackPanel>
                </Button>
            </Border>
            <Grid x:Name="Viewport" ClipToBounds="True">
                <ScrollViewer x:Name="ItemScroll" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" PanningMode="None"
                              Focusable="False" Background="Transparent">
                    <UniformGrid x:Name="ItemStrip" Rows="1"/>
                </ScrollViewer>
                <ScrollViewer x:Name="GridScroll" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              PanningMode="None" Focusable="False" Background="Transparent">
                    <Canvas x:Name="TileCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"/>
                </ScrollViewer>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="DropIndicator" Visibility="Collapsed" Background="{StaticResource DockAccent}"
                            CornerRadius="1"/>
                </Canvas>
            </Grid>
        </DockPanel>
    </Border>
        <Thumb Style="{StaticResource ResizeZone}" Tag="Left" HorizontalAlignment="Left" Width="6" Margin="0,9,0,9" Cursor="SizeWE"/>
        <Thumb Style="{StaticResource ResizeZone}" Tag="Right" HorizontalAlignment="Right" Width="6" Margin="0,9,0,9" Cursor="SizeWE"/>
        <Thumb Style="{StaticResource ResizeZone}" Tag="Top" VerticalAlignment="Top" Height="6" Margin="9,0,9,0" Cursor="SizeNS"/>
        <Thumb Style="{StaticResource ResizeZone}" Tag="Bottom" VerticalAlignment="Bottom" Height="6" Margin="9,0,9,0" Cursor="SizeNS"/>
        <Thumb Style="{StaticResource ResizeZone}" Tag="Left Top" HorizontalAlignment="Left" VerticalAlignment="Top" Width="9" Height="9" Cursor="SizeNWSE"/>
        <Thumb Style="{StaticResource ResizeZone}" Tag="Right Top" HorizontalAlignment="Right" VerticalAlignment="Top" Width="9" Height="9" Cursor="SizeNESW"/>
        <Thumb Style="{StaticResource ResizeZone}" Tag="Left Bottom" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="9" Height="9" Cursor="SizeNESW"/>
        <Thumb Style="{StaticResource ResizeZone}" Tag="Right Bottom" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="9" Height="9" Cursor="SizeNWSE"/>
    </Grid>
</Window>
