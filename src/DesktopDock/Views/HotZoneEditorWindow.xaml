<Window x:Class="DesktopDock.HotZoneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑热区" Width="466" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources><ResourceDictionary Source="SettingsStyles.xaml" /></Window.Resources>
    <Border Background="{StaticResource Canvas}" Padding="22">
        <StackPanel>
            <TextBlock Text="屏幕边缘" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="EdgeInput" AutomationProperties.Name="屏幕边缘" Height="34" VerticalContentAlignment="Center">
                <ComboBoxItem Content="上边缘" />
                <ComboBoxItem Content="下边缘" />
                <ComboBoxItem Content="左边缘" />
                <ComboBoxItem Content="右边缘" />
            </ComboBox>
            <UniformGrid Columns="2" Margin="0,12,0,0">
                <StackPanel Margin="0,0,7,12">
                    <TextBlock Text="起点 (%)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="StartInput" AutomationProperties.Name="热区起点百分比" />
                </StackPanel>
                <StackPanel Margin="7,0,0,12">
                    <TextBlock Text="终点 (%)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="EndInput" AutomationProperties.Name="热区终点百分比" />
                </StackPanel>
                <StackPanel Margin="0,0,7,12">
                    <TextBlock Text="厚度 (DIP)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ThicknessInput" AutomationProperties.Name="热区厚度" />
                </StackPanel>
                <StackPanel Margin="7,0,0,12">
                    <TextBlock Text="向内偏移 (DIP)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="OffsetInput" AutomationProperties.Name="热区向内偏移" />
                </StackPanel>
                <StackPanel Margin="0,0,7,0">
                    <TextBlock Text="呼出延迟 (ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="RevealDelayInput" AutomationProperties.Name="呼出延迟" />
                </StackPanel>
                <StackPanel Margin="7,0,0,0">
                    <TextBlock Text="收起延迟 (ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HideDelayInput" AutomationProperties.Name="收起延迟" />
                </StackPanel>
            </UniformGrid>
            <TextBlock x:Name="ValidationMessage" Visibility="Collapsed" Foreground="#FF9A3025" TextWrapping="Wrap" Margin="0,11,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="应用" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Apply" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
