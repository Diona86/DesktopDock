<UserControl x:Class="DesktopDock.HotkeySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,6">
            <TextBlock Text="选中输入框后按下组合键。Tab 切换输入框，Esc 结束录入。"
                       Style="{DynamicResource FieldHint}" Margin="0,0,0,14" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="呼出 / 收起" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox Grid.Column="1" x:Name="ToggleInput" AutomationProperties.Name="呼出或收起快捷键" IsReadOnly="True"
                         PreviewKeyDown="RecordKey" Margin="0,0,8,8" />
                <Button Grid.Column="2" Content="清空" Tag="0" AutomationProperties.Name="清空呼出或收起快捷键" Click="ClearBinding" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Text="临时显示" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PeekInput" AutomationProperties.Name="临时显示快捷键" IsReadOnly="True"
                         PreviewKeyDown="RecordKey" Margin="0,0,8,8" />
                <Button Grid.Row="1" Grid.Column="2" Content="清空" Tag="1" AutomationProperties.Name="清空临时显示快捷键" Click="ClearBinding" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Text="锁定 / 解锁显示" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="LockInput" AutomationProperties.Name="锁定或解锁显示快捷键" IsReadOnly="True"
                         PreviewKeyDown="RecordKey" Margin="0,0,8,8" />
                <Button Grid.Row="2" Grid.Column="2" Content="清空" Tag="2" AutomationProperties.Name="清空锁定或解锁显示快捷键" Click="ClearBinding" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Text="暂停 / 恢复热区" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="PauseInput" AutomationProperties.Name="暂停或恢复热区快捷键" IsReadOnly="True"
                         PreviewKeyDown="RecordKey" Margin="0,0,8,0" />
                <Button Grid.Row="3" Grid.Column="2" Content="清空" Tag="3" AutomationProperties.Name="清空暂停或恢复热区快捷键" Click="ClearBinding" />
            </Grid>
            <Button Content="恢复默认组合" Click="ResetBindings" HorizontalAlignment="Left" Margin="0,14,0,5" />
            <TextBlock x:Name="BindingValidationStatus" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"
                       Foreground="#FF9A3025" TextWrapping="Wrap" Margin="0,7,0,0" />
            <TextBlock x:Name="RegistrationStatus" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"
                       Foreground="#FF9A3025" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
