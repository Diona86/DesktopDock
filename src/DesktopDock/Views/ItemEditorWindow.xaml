<Window x:Class="DesktopDock.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑项目" Width="570" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources><ResourceDictionary Source="SettingsStyles.xaml" /></Window.Resources>
    <Border Background="{StaticResource Canvas}" Padding="24">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="显示名称" />
            <TextBox x:Name="NameInput" AutomationProperties.Name="显示名称" Margin="0,0,0,16" />
            <TextBlock x:Name="TargetLabel" Style="{StaticResource FieldLabel}" Text="目标路径或网址" />
            <TextBox x:Name="TargetInput" AutomationProperties.Name="目标路径或网址" />
            <WrapPanel x:Name="TargetActions" Margin="0,7,0,0">
                <Button Content="选择文件" Click="BrowseFile" Margin="0,0,8,0" />
                <Button Content="选择文件夹" Click="BrowseFolder" />
            </WrapPanel>
            <StackPanel x:Name="IconActions" Margin="0,17,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="展示图标" />
                <TextBlock x:Name="IconLabel" TextTrimming="CharacterEllipsis" Style="{StaticResource FieldHint}" />
                <WrapPanel Margin="0,5,0,0">
                    <Button Content="选择图标" Click="BrowseIcon" Margin="0,0,8,0" />
                    <Button Content="恢复默认" Click="ResetIcon" />
                </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="ValidationMessage" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#FF9A3025" Margin="0,13,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
