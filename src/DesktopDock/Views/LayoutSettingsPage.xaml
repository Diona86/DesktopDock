<UserControl x:Class="DesktopDock.LayoutSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary Source="SettingsStyles.xaml" /></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Dock 布局方式" />
                    <ComboBox x:Name="ModeInput" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="Dock 布局方式">
                        <ComboBoxItem Content="随停靠方向" />
                        <ComboBoxItem Content="单行" />
                        <ComboBoxItem Content="单列" />
                        <ComboBoxItem Content="多行网格" />
                        <ComboBoxItem Content="多列网格" />
                        <ComboBoxItem Content="分组展开" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="默认展开方向" />
                    <ComboBox x:Name="DirectionInput" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="默认展开方向">
                        <ComboBoxItem Content="随停靠方向" />
                        <ComboBoxItem Content="向上" />
                        <ComboBoxItem Content="向下" />
                        <ComboBoxItem Content="向左" />
                        <ComboBoxItem Content="向右" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="图标上限" />
                    <TextBox x:Name="MaxIconsInput" AutomationProperties.Name="可见图标上限" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="0 为自动" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="网格行 / 列" />
                    <TextBox x:Name="GridTracksInput" AutomationProperties.Name="网格行列数" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="2–8" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="图标间距" />
                    <TextBox x:Name="IconSpacingInput" AutomationProperties.Name="图标间距" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="0–32 DIP" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="面板间距" />
                    <TextBox x:Name="PanelSpacingInput" AutomationProperties.Name="面板间距" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="0–48 DIP" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0" Text="图标尺寸可在「Dock 外观」调整。" />

            <Border Margin="0,15,0,12" Height="1" Background="{StaticResource Rule}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="分组" />
            <Border CornerRadius="5" BorderThickness="1" BorderBrush="{StaticResource Rule}" Background="White">
                <Grid>
                    <ListView x:Name="GroupsList" Height="105" BorderThickness="0" Background="Transparent"
                              Foreground="{StaticResource Ink}" SelectionMode="Single" SelectionChanged="SelectGroup"
                              AutomationProperties.Name="Dock 分组">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="名称" Width="198">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="展开方式" Width="84" DisplayMemberBinding="{Binding Mode}" />
                                <GridViewColumn Header="直接项目" Width="77" DisplayMemberBinding="{Binding ItemCount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="EmptyGroups" Style="{StaticResource FieldHint}" HorizontalAlignment="Center"
                               Margin="12,41,12,0" Text="创建分组后，可将项目拖入分组。" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <WrapPanel Margin="0,9,0,0">
                <Button Content="新建分组" Click="CreateGroup" Margin="0,0,7,4" />
                <Button x:Name="AddSubgroupButton" Content="新建子分组" Click="CreateSubgroup" Margin="0,0,7,4" />
                <Button x:Name="EditGroupButton" Content="编辑分组" Click="EditGroup" Margin="0,0,7,4" />
                <Button x:Name="DeleteGroupButton" Content="删除分组" Click="DeleteGroup" Margin="0,0,0,4" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
