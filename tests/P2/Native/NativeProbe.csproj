<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ApplicationManifest>../../../src/DesktopDock/app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/DesktopDock/GlobalUsings.cs" />
    <Compile Include="../../../src/DesktopDock/Core/*.cs" />
    <Compile Include="../../../src/DesktopDock/Windows/DockWindows.cs" />
    <Compile Include="../../../src/DesktopDock/Windows/DockHotkeyService.cs" />
    <Compile Include="../../../src/DesktopDock/Windows/DockOutsideClickMonitor.cs" />
  </ItemGroup>
</Project>
